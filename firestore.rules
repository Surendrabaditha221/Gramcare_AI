rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Private user data.
    // A signed-in user can access only their own user tree.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      match /{subcollection}/{documentId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Shared medical knowledge.
    // Clients may read verified knowledge, but clients cannot modify it.
    match /medical_knowledge_base/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}