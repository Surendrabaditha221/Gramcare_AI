# GramCare AI Backend Production Environment Template (Render Free Web Service)
# Set these environment variables in the Render Dashboard under your Web Service Settings.

ENVIRONMENT=production
FIREBASE_PROJECT_ID=gramcare-ai-5fffb
ALLOWED_ORIGINS=https://gramcare-ai-5fffb.web.app,https://gramcare-ai-5fffb.firebaseapp.com

# Google Gemini API Key (Secret)
GEMINI_API_KEY=your_production_gemini_api_key

# Firebase Service Account JSON (Secret)
# Paste the entire content of your Firebase service-account JSON as a single-line or multi-line string in Render Environment Variables.
# NEVER commit or expose this key.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"gramcare-ai-5fffb",...}
