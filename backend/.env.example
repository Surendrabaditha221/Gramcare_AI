# GramCare AI Backend Environment Configuration Template
# Copy this file to backend/.env and populate your secret credentials.

# -------------------------------------------------------------
# Environment Mode
# -------------------------------------------------------------
ENVIRONMENT=development
# Set to 'production' in production deployments
# ENVIRONMENT=production

# -------------------------------------------------------------
# Server Configuration
# -------------------------------------------------------------
PORT=8000
HOST=127.0.0.1

# Allowed CORS Origins (comma-separated, no trailing slashes)
# Development:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:8000
# Production:
# ALLOWED_ORIGINS=https://gramcare.yourdomain.com,https://app.gramcare.yourdomain.com

# -------------------------------------------------------------
# Google Gemini API Key
# -------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------
# Firebase Admin SDK & Cloud Firestore Configuration
# -------------------------------------------------------------
FIREBASE_PROJECT_ID=gramcare-ai-5fffb
# Path to service account JSON file (relative to backend/ or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
# Alternatively, set GOOGLE_APPLICATION_CREDENTIALS:
# GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-service-account.json

# -------------------------------------------------------------
# Authentication JWT Secret Keys
# -------------------------------------------------------------
# Generate strong random keys for production: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_strong_random_secret_in_production
JWT_REFRESH_SECRET_KEY=change_this_to_a_strong_random_refresh_secret_in_production

# -------------------------------------------------------------
# Emergency SOS Email Alert Delivery Configuration (Gmail SMTP)
# -------------------------------------------------------------
# Providers:
#   'smtp'                             - Direct outgoing SMTP (e.g. Gmail SMTP).
#   'firebase_trigger_email'           - Writes jobs to Firestore 'mail' collection watched by
#                                        the Firebase Trigger Email extension.
# If unconfigured, SOS functions normally and reports 'email_not_configured' status.
EMAIL_PROVIDER=smtp
EMAIL_FROM=your-sender@gmail.com

# Gmail SMTP Settings:
# IMPORTANT:
# - SMTP_PASSWORD MUST be a 16-character Google App Password (e.g., 'abcd efgh ijkl mnop').
# - DO NOT use your regular Google/Gmail password.
# - Google requires 2-Step Verification enabled to generate an App Password:
#   Google Account -> Security -> 2-Step Verification -> App Passwords (https://support.google.com/mail/answer/185833)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_USE_TLS=true

# Optional: test recipient email for backend/test_gmail_smtp.py verification
TEST_EMAIL_RECIPIENT=test@example.com
