# GramCare AI Frontend Environment Configuration Template
# Copy this file to .env and configure for your environment.

# -------------------------------------------------------------
# Backend API Base URL
# -------------------------------------------------------------
# Development:
VITE_API_BASE_URL=http://127.0.0.1:8000
# Production:
# VITE_API_BASE_URL=https://api.gramcare.yourdomain.com

# -------------------------------------------------------------
# Firebase Web Client Configuration (Public Identifiers)
# -------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
