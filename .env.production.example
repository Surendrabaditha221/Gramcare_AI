# ==============================================================================
# GramCare AI - Production Frontend Environment Template (Render Static Site)
# ==============================================================================
# IMPORTANT:
# These variables are bundled into client-side JavaScript by Vite at build time.
# ONLY public identifiers belong here.
# NEVER place backend private keys (GEMINI_API_KEY, FIREBASE_SERVICE_ACCOUNT_JSON,
# JWT_SECRET, SMTP passwords) in this file or with VITE_ prefixes.
# ==============================================================================

# 1. Render FastAPI Backend Base URL (HTTPS)
# Set this to your deployed Render FastAPI service URL (e.g. https://gramcare-api.onrender.com)
VITE_API_BASE_URL=https://your-gramcare-api.onrender.com

# 2. Firebase Web Client Configuration (Public Browser Identifiers)
# Obtained from Firebase Console > Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=gramcare-ai-5fffb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gramcare-ai-5fffb
VITE_FIREBASE_STORAGE_BUCKET=gramcare-ai-5fffb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=164999261973
VITE_FIREBASE_APP_ID=your_firebase_web_app_id

# 3. Optional Web Push VAPID Public Key
# Obtained from Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
# VITE_FIREBASE_VAPID_KEY=your_public_vapid_key
